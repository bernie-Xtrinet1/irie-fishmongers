enum OrdinaryProvenanceState {
  HISTORICAL_UNVERIFIED
  NEW
  TRACKED
}

enum OrdinaryOwnerState {
  ISSUED
  ACTIVE
  RELEASE_PENDING
  TRANSFER_PENDING
  TRANSFERRED
  CONSUMED
  SUPERSEDED
  REVOKED
}

enum OrdinaryCommandEffect {
  W1
  RELEASE
  CANCEL_W1
  CHECKOUT_COMPLETE
}

enum OrdinaryCommandState {
  WAITING
  PENDING
  UNCERTAIN
  REVOCATION_PENDING
  ACKNOWLEDGED
  CANCELLED
  REVOKED
}

enum OrdinaryCommandReason {
  CART_INTENT
  CART_REMOVAL
  COMPENSATION_ABSENCE
  RECOVERY_ABSENCE
  RETIREMENT
  STALE_W1
  CHECKOUT_SETTLED
}

enum OrdinaryW1Transition {
  INITIAL
  SAME_GENERATION
  IMMEDIATE_PREDECESSOR
  AFTER_CONSUMPTION
}

// A hold is a globally unique physical lifetime; quantity is command payload,
// never part of canonical identity. Canonical UUIDv5 equality is checked in TS.
model OrdinaryReservationOwner {
  id                        String                         @id @default(uuid()) @db.Uuid
  markerId                  String
  generation                Int
  holdInstanceId            String                         @unique @db.Uuid
  customerId                String
  cartId                    String
  productId                 String
  incarnation               String                         @db.Uuid
  reservationExecutionEpoch Int
  issuanceTransitionId      String                         @db.Uuid
  state                     OrdinaryOwnerState             @default(ISSUED)
  checkoutManifestId        String?                        @db.Uuid
  createdAt                 DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                       @updatedAt @db.Timestamptz(3)
  closedAt                  DateTime?                      @db.Timestamptz(3)
  marker                    CartReservationSyncState       @relation(fields: [markerId, cartId, productId], references: [id, cartId, productId], onDelete: Restrict, onUpdate: Restrict)
  cart                      Cart                           @relation(fields: [cartId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  issuanceTransition        ReservationFenceTransition     @relation(fields: [issuanceTransitionId, incarnation, reservationExecutionEpoch], references: [id, incarnation, epoch], onDelete: Restrict, onUpdate: Restrict)
  checkoutManifest          CheckoutReservationSettlement? @relation(fields: [checkoutManifestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commands                  OrdinaryReservationCommand[]   @relation("OrdinaryTarget")
  sourceCommands            OrdinaryReservationCommand[]   @relation("OrdinarySource")

  @@unique([markerId, generation])
  @@unique([id, markerId])
  @@index([markerId, state, generation])
  @@index([state, id])
  @@index([cartId, productId, state])
  @@index([incarnation, reservationExecutionEpoch, state])
  @@index([checkoutManifestId])
  @@map("ordinary_reservation_owners")
}

// Partial indexes and transition/counter guards are in the migration.
// Receipts here are structurally validated persistence evidence, not Redis proof.
model OrdinaryReservationCommand {
  invalidationBinding      OrdinaryCommandBarrierBinding?
  id                       String                         @id @default(uuid()) @db.Uuid
  markerId                 String
  ownerId                  String                         @db.Uuid
  sourceOwnerId            String?                        @db.Uuid
  effect                   OrdinaryCommandEffect
  reason                   OrdinaryCommandReason
  w1Transition             OrdinaryW1Transition?
  intentGeneration         Int
  expectedMutationVersion  Int
  authorizedQuantity       Int?
  queueOrdinal             Int
  sequence                 Int?
  expectedSequence         Int?
  replayId                 String                         @unique @default(uuid()) @db.Uuid
  state                    OrdinaryCommandState           @default(WAITING)
  dependsOnCommandId       String?                        @db.Uuid
  cancelledCommandId       String?                        @db.Uuid
  checkoutManifestId       String?                        @db.Uuid
  settlementReceiptHash    String?                        @db.Char(64)
  causeTransitionId        String?                        @db.Uuid
  lastDispatchTransitionId String?                        @db.Uuid
  attemptCount             Int                            @default(0)
  nextAttemptAt            DateTime?                      @db.Timestamptz(3)
  completionReceiptHash    String?                        @db.Char(64)
  createdAt                DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                       @updatedAt @db.Timestamptz(3)
  acknowledgedAt           DateTime?                      @db.Timestamptz(3)
  marker                   CartReservationSyncState       @relation(fields: [markerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  owner                    OrdinaryReservationOwner       @relation("OrdinaryTarget", fields: [ownerId, markerId], references: [id, markerId], onDelete: Restrict, onUpdate: Restrict)
  sourceOwner              OrdinaryReservationOwner?      @relation("OrdinarySource", fields: [sourceOwnerId, markerId], references: [id, markerId], onDelete: Restrict, onUpdate: Restrict)
  dependency               OrdinaryReservationCommand?    @relation("OrdinaryDependency", fields: [dependsOnCommandId, markerId], references: [id, markerId], onDelete: Restrict, onUpdate: Restrict)
  dependants               OrdinaryReservationCommand[]   @relation("OrdinaryDependency")
  cancelledCommand         OrdinaryReservationCommand?    @relation("OrdinaryCancellation", fields: [cancelledCommandId, markerId], references: [id, markerId], onDelete: Restrict, onUpdate: Restrict)
  cancellations            OrdinaryReservationCommand[]   @relation("OrdinaryCancellation")
  checkoutManifest         CheckoutReservationSettlement? @relation(fields: [checkoutManifestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  causeTransition          ReservationFenceTransition?    @relation("OrdinaryCause", fields: [causeTransitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lastDispatchTransition   ReservationFenceTransition?    @relation("OrdinaryDispatch", fields: [lastDispatchTransitionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([markerId, queueOrdinal])
  @@unique([markerId, sequence])
  @@unique([id, markerId])
  @@index([state, nextAttemptAt, queueOrdinal, id])
  @@index([ownerId, effect, state])
  @@index([markerId, state, queueOrdinal])
  @@map("ordinary_reservation_commands")
}

// Inactive invalidation protocol. Installation inserts no scope heads and
// backfills no command bindings. Scope rows constitute explicit enrollment.
enum OrdinaryInvalidationStatus {
  PREPARED
  BARRIER_CONFIRMED
  PUBLISHED
  SUPERSEDED
}

model OrdinaryInvalidationIntent {
  id                String                     @id @db.Uuid
  operationId       String                     @unique @db.Uuid
  kind              String                     @db.VarChar(8)
  request           Json
  digest            String                     @db.Char(64)
  status            OrdinaryInvalidationStatus @default(PREPARED)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  acknowledgement   String?
  acknowledgementHash String?                  @db.Char(64)
  publicationTx     BigInt?
  publishedAt       DateTime?                  @db.Timestamptz(3)
  resultReference   Json?
  supersededById    String?                    @db.Uuid
  supersededBy      OrdinaryInvalidationIntent? @relation("InvalidationReplacement", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersedes        OrdinaryInvalidationIntent[] @relation("InvalidationReplacement")
  scopes            OrdinaryInvalidationScope[]
  pendingHeads      OrdinaryInvalidationHead[]

  @@index([status, id])
  @@map("ordinary_invalidation_intents")
}

model OrdinaryInvalidationHead {
  scope             String                     @id
  incarnation       String                     @db.Uuid
  epoch             Int
  publishedRevision Int                        @default(0)
  allocatedRevision Int                        @default(0)
  ready             Boolean                    @default(false)
  pendingIntentId   String?                    @db.Uuid
  pendingIntent     OrdinaryInvalidationIntent? @relation(fields: [pendingIntentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  allocations       OrdinaryInvalidationScope[]

  @@map("ordinary_invalidation_heads")
}

model OrdinaryInvalidationScope {
  intentId          String                     @db.Uuid
  scope             String
  previousRevision  Int
  revision          Int
  snapshot          Json
  intent            OrdinaryInvalidationIntent @relation(fields: [intentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  head              OrdinaryInvalidationHead   @relation(fields: [scope], references: [scope], onDelete: Restrict, onUpdate: Restrict)

  @@id([intentId, scope])
  @@unique([scope, revision])
  @@map("ordinary_invalidation_scopes")
}

model OrdinaryCommandBarrierBinding {
  commandId         String                     @id @db.Uuid
  replayId          String                     @unique @db.Uuid
  markerId          String
  version           Int
  globalRevision    Int
  markerRevision    Int
  incarnation       String                     @db.Uuid
  epoch             Int
  command           OrdinaryReservationCommand @relation(fields: [commandId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("ordinary_command_barrier_bindings")
}

