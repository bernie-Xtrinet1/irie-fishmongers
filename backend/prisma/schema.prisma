// automated sanitation verification is explicitly out of scope here (no
// physical sensor hardware exists to integrate against); this is
// manually-recorded, matching every other compliance record in this
// codebase (TemperatureReading, QualityInspection, etc. are all
// human-entered too).
enum SanitationStatus {
  COMPLETED
  OVERDUE
}

model FleetSanitationRecord {
