generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CUSTOMER
  VENDOR
  DRIVER
  ADMINISTRATOR
  FISHERMAN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                              String     @id @default(uuid())
  email                           String     @unique
  passwordHash                    String
  firstName                       String
  lastName                        String
  phone                           String?
  status                          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt                 DateTime?
  emailVerificationTokenHash      String?
  emailVerificationTokenExpiresAt DateTime?
  passwordResetTokenHash          String?
  passwordResetTokenExpiresAt     DateTime?
  createdAt                       DateTime   @default(now())
  updatedAt                       DateTime   @updatedAt

  roles                        UserRole[]
  refreshTokens                RefreshToken[]
  vendor                       Vendor?
  driver                       Driver?
  fisherman                    Fisherman?
  cart                         Cart?
  orders                       Order[]
  checkoutAttempts             CheckoutAttempt[]
  checkoutOperations           CheckoutOperation[]
  cartItemAddAttempts          CartItemAddAttempt[]
  temperatureReadings          TemperatureReading[]
  qualityInspections           QualityInspection[]
  reportedIncidents            FoodSafetyIncident[]
  createdRecalls               Recall[]
  notifications                Notification[]
  notificationPreference       NotificationPreference?
  deviceTokens                 DeviceToken[]
  verifiedDocuments            VendorDocument[]                 @relation("DocumentVerifiedBy")
  reviewedUpgradeRequests      VendorUpgradeRequest[]           @relation("UpgradeRequestReviewedBy")
  triggeredDowngrades          VendorDowngradeEvent[]           @relation("DowngradeTriggeredBy")
  marketplaceModeUpdates       MarketplaceModeConfig[]
  reservationEngineModeUpdates ReservationEngineModeConfig[]
  cartMutationBarrierUpdates   CartMutationBarrierConfig[]
  vendorSelectionWeightUpdates VendorSelectionWeightConfig[]
  fulfillmentDecisions         FulfillmentDecision[]
  triggeredInventoryEvents     InventoryEvent[]
  vendorConfirmedDeliveries    Delivery[]                       @relation("DeliveryVendorConfirmedBy")
  resolvedDeliveryExceptions   DeliveryException[]              @relation("DeliveryExceptionResolvedBy")
  resolvedSLABreaches          SLABreach[]                      @relation("SLABreachResolvedBy")
  complianceAuditLogs          ComplianceAuditLog[]
  uploadedComplianceDocuments  ComplianceDocument[]
  custodyEventsAsSender        ChainOfCustodyEvent[]            @relation("CustodyEventFrom")
  custodyEventsAsRecipient     ChainOfCustodyEvent[]            @relation("CustodyEventTo")
  assignedEmergencyResponses   EmergencyResponse[]
  recordedWasteDisposals       WasteDisposalRecord[]
  reviewsAuthored              Review[]                         @relation("ReviewAuthor")
  reviewsRemoved               Review[]                         @relation("ReviewRemovedBy")
  reviewModerationActions      ReviewAuditLog[]                 @relation("ReviewModerationActor")
  checkoutRolloutRevisions     CheckoutRolloutParticipant[]     @relation("CheckoutRolloutCustomer")
  checkoutRolloutChanges       CheckoutRolloutParticipant[]     @relation("CheckoutRolloutActor")
  checkoutRolloutControls      CheckoutRolloutControlRevision[]
  requestedRegulatoryOverrides RegulatoryOverride[]             @relation("RegulatoryOverrideRequester")
  approvedRegulatoryOverrides  RegulatoryOverride[]             @relation("RegulatoryOverrideApprover")
  withdrawnListingPhotos       ListingPhoto[]                   @relation("ListingPhotoWithdrawnBy")
  recordedWeightMeasurements   SeafoodWeightMeasurementEvent[]  @relation("WeightMeasurementOperator")
  recordedPreparationEvents    SeafoodPreparationFulfillmentEvent[] @relation("PreparationFulfillmentOperator")
  checkoutCeilingConsents      CustomerCheckoutCeilingConsent[] @relation("CheckoutCeilingConsentCustomer")
  weightApprovalRecords        CustomerWeightApprovalRecord[]   @relation("WeightApprovalCustomer")
  weightApprovalChallenges     CustomerWeightApprovalChallenge[] @relation("ApprovalChallengeCustomer")
  settledWeightAdjustments     WeightAdjustmentSettlementRecord[] @relation("AdjustmentSettlementRecorder")
  cutoverFreshnessResetAudits  CutoverFreshnessResetAudit[]       @relation("FreshnessResetOperator")
  requestedSuspectRecoveries   ProductSuspectRecovery[]           @relation("SuspectRecoveryRequester")
  approvedSuspectRecoveries    ProductSuspectRecovery[]           @relation("SuspectRecoveryApprover")
  rejectedSuspectRecoveries    ProductSuspectRecovery[]           @relation("SuspectRecoveryRejector")

  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum Parish {
  KINGSTON
  ST_ANDREW
  ST_CATHERINE
  CLARENDON
  MANCHESTER
  ST_ELIZABETH
  HANOVER
  WESTMORELAND
  ST_JAMES
  TRELAWNY
  ST_ANN
  ST_MARY
  PORTLAND
  ST_THOMAS
}

model Vendor {
  id                       String       @id @default(uuid())
  userId                   String       @unique
  businessName             String
  description              String?
  phone                    String?
  parish                   Parish
  logoUrl                  String?
  status                   VendorStatus @default(PENDING)
  tier                     VendorTier   @default(COMMUNITY_FISHER)
  complianceScore          Int?
  // When complianceScore was last recomputed (Phase 13C). Written together
  // with the score so any reader can tell how fresh it is; null until the
  // vendor has been assessed for the first time.
  complianceScoreUpdatedAt DateTime?
  termsAcceptedAt          DateTime
  primaryZoneId            String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryZone        DeliveryZone?             @relation("VendorPrimaryZone", fields: [primaryZoneId], references: [id], onDelete: SetNull)
  secondaryZones     VendorZone[]
  products           Product[]
  vendorOrders       VendorOrder[]
  settlements        VendorSettlement[]
  seafoodLots        SeafoodLot[]
  documents          VendorDocument[]
  upgradeRequests    VendorUpgradeRequest[]
  downgradeEvents    VendorDowngradeEvent[]
  vendorScores       VendorScore[]
  vendorAssignments  VendorAssignment[]
  fishermen          Fisherman[]
  temperatureDevices TemperatureDevice[]
  certifications     RegulatoryCertification[]
  reviews            Review[]
  dailyListings           VendorDailyListing[]
  receivables             VendorReceivable[]
  settlementDisbursements VendorSettlementDisbursement[]

  @@map("vendors")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products       Product[]
  catalogueItems SeafoodCatalogueItem[]

  @@map("categories")
}

enum ProductUnit {
  PER_POUND
  PER_KILOGRAM
  PER_PACKAGE
  PER_ITEM
}

enum CatalogueCompositionMode {
  SINGLE_SPECIES
  FIXED_COMPOSITE
  VARIABLE_COMPOSITE
  UNVERIFIED_COMPOSITION
}

enum CatalogueLifecycleStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  RETIRED
}

enum CatalogueRetirementReason {
  COMMERCIAL_RETIREMENT
  DUPLICATE_CONSOLIDATION
  SAFETY_REGULATORY_RETIREMENT
  DATA_CORRECTION
}

enum InventoryMode {
  LEGACY_PRODUCT
  MIGRATION_PENDING
  LISTING_BACKED
}

enum RegulatoryOverrideReason {
  DATA_CORRECTION
}

model SeafoodCatalogueItem {
  id                  String                    @id @default(uuid())
  name                String
  scientificName      String?
  scientificFamily    String?
  commonName          String
  jamaicanNames       String[]                  @default([])
  description         String?
  categoryId          String
  compositionMode     CatalogueCompositionMode  @default(UNVERIFIED_COMPOSITION)
  lifecycleStatus     CatalogueLifecycleStatus  @default(DRAFT)
  retirementReason    CatalogueRetirementReason?
  retirementNotes     String?
  consolidatedIntoId  String?
  referenceImageUrl   String?
  imageSourceLicense  String?
  typicalUnit         ProductUnit               @default(PER_POUND)
  typicalSizeMinCm    Decimal?                  @db.Decimal(6, 2)
  typicalSizeMaxCm    Decimal?                  @db.Decimal(6, 2)
  typicalWeightMinLbs Decimal?                  @db.Decimal(6, 2)
  typicalWeightMaxLbs Decimal?                  @db.Decimal(6, 2)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  category            Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  speciesLinks        CatalogueItemSpecies[]
  products            Product[]
  regulatoryOverrides RegulatoryOverride[]
  consolidatedInto    SeafoodCatalogueItem?     @relation("CatalogueConsolidation", fields: [consolidatedIntoId], references: [id])
  consolidatedFrom    SeafoodCatalogueItem[]    @relation("CatalogueConsolidation")
  dailyListings       VendorDailyListing[]

  @@index([categoryId])
  @@index([lifecycleStatus])
  @@index([compositionMode])
  @@index([consolidatedIntoId])
  @@map("seafood_catalogue_items")
}

model CatalogueItemSpecies {
  catalogueItemId   String
  speciesId         String
  isPrimary         Boolean  @default(false)
  typicalProportion Decimal? @db.Decimal(5, 2)
  createdAt         DateTime @default(now())

  catalogueItem SeafoodCatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  species       Species              @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@id([catalogueItemId, speciesId])
  @@index([speciesId])
  @@map("catalogue_item_species")
}

model RegulatoryOverride {
  id                  String                   @id @default(uuid())
  catalogueItemId     String
  requestedByUserId   String
  approvedByUserId    String?
  reason              RegulatoryOverrideReason @default(DATA_CORRECTION)
  justification       String
  documentEvidenceUrl String?
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime                 @default(now())

  catalogueItem   SeafoodCatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)
  requestedByUser User                 @relation("RegulatoryOverrideRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedByUser  User?                @relation("RegulatoryOverrideApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  @@index([catalogueItemId])
  @@index([expiresAt])
  @@map("regulatory_overrides")
}

enum ListingLifecycleStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
  SUSPENDED
}

enum ListingPhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SeafoodOriginType {
  WILD_CAUGHT
  AQUACULTURE
  IMPORTED
  PROCESSED
}

enum SeafoodAcquisitionType {
  DIRECT_CATCH
  COOPERATIVE_PURCHASE
  WHOLESALE_PURCHASE
  TRANSFER
  CONSIGNMENT
  OTHER
}

model VendorDailyListing {
  id                 String                      @id @default(uuid())
  vendorId           String
  productId          String
  catalogueItemId    String
  lotId              String
  landingSiteId      String?
  listingTitle       String?
  description        String?
  catchDate          DateTime
  availableFrom      DateTime                    @default(now())
  expiresAt          DateTime
  unit               ProductUnit                 @default(PER_POUND)
  price              Decimal                     @db.Decimal(10, 2)
  currency           String                      @default("JMD")
  quantityUploaded   Decimal                     @db.Decimal(10, 2)
  quantityAvailable  Decimal                     @db.Decimal(10, 2)
  quantityReserved   Decimal                     @default(0) @db.Decimal(10, 2)
  quantitySold       Decimal                     @default(0) @db.Decimal(10, 2)
  preparationOptions Json?
  deliveryAvailable  Boolean                     @default(true)
  pickupAvailable    Boolean                     @default(true)
  status             ListingLifecycleStatus      @default(DRAFT)
  withdrawnAt        DateTime?
  withdrawnReason    String?
  suspendedAt        DateTime?
  suspensionReason   String?
  publishedAt        DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  vendor              Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product             Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  catalogueItem       SeafoodCatalogueItem        @relation(fields: [catalogueItemId], references: [id], onDelete: Restrict)
  lot                 SeafoodLot                  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  landingSite         LandingSite?                @relation(fields: [landingSiteId], references: [id], onDelete: SetNull)
  photos              ListingPhoto[]
  speciesDeclarations VendorDailyListingSpecies[]
  orderItems          OrderItem[]

  @@index([vendorId, status])
  @@index([catalogueItemId, status])
  @@index([productId])
  @@index([lotId])
  @@index([status, expiresAt])
  @@map("vendor_daily_listings")
}

model ListingPhoto {
  id                   String                       @id @default(uuid())
  vendorDailyListingId String
  url                  String
  caption              String?
  isPrimary            Boolean                      @default(false)
  moderationStatus     ListingPhotoModerationStatus @default(APPROVED)
  uploadedAt           DateTime                     @default(now())
  captureDate          DateTime?
  withdrawnAt          DateTime?
  withdrawnByUserId    String?
  withdrawnReason      String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  listing         VendorDailyListing @relation(fields: [vendorDailyListingId], references: [id], onDelete: Cascade)
  withdrawnByUser User?              @relation("ListingPhotoWithdrawnBy", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)

  @@index([vendorDailyListingId])
  @@map("listing_photos")
}

model VendorDailyListingSpecies {
  id                   String             @id @default(uuid())
  vendorDailyListingId String
  speciesId            String
  proportion           Decimal?           @db.Decimal(5, 2)
  notes                String?
  createdAt            DateTime           @default(now())

  listing VendorDailyListing @relation(fields: [vendorDailyListingId], references: [id], onDelete: Cascade)
  species Species            @relation(fields: [speciesId], references: [id], onDelete: Restrict)

  @@unique([vendorDailyListingId, speciesId])
  @@map("vendor_daily_listing_species")
}

model Product {
  reservationRestrictions  ProductReservationRestriction[]
  productSuspectRecoveries ProductSuspectRecovery[]
  id                String        @id @default(uuid())
  vendorId          String
  categoryId        String
  lotId             String?
  catalogueItemId   String?
  inventoryMode     InventoryMode @default(LEGACY_PRODUCT)
  name              String
  description       String
  unit              ProductUnit
  price             Decimal       @db.Decimal(10, 2)
  currency          String        @default("JMD")
  quantityAvailable Int           @default(0)
  imageUrl          String
  isActive          Boolean       @default(true)
  // Per-unit weight (matching `unit`'s own measure, e.g. per pound/kg/package/
  // item) - nullable because most products predate this field. Added for the
  // 10A Fleet Dispatch Engine's driver/fleet-asset capacity check; existing
  // vendors must set it before their products count toward any capacity
  // calculation. Deliberately NOT reusing DriverSettlementEngine's
  // computePoundsEquivalent() heuristic (PER_POUND/PER_KILOGRAM only, silently
  // 0 for PER_PACKAGE/PER_ITEM) - this field is the real, direct value that
  // heuristic was always a stand-in for.
  weightLbs         Decimal?      @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  vendor                          Vendor                        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category                        Category                      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lot                             SeafoodLot?                   @relation(fields: [lotId], references: [id], onDelete: Restrict)
  catalogueItem                   SeafoodCatalogueItem?         @relation(fields: [catalogueItemId], references: [id], onDelete: Restrict)
  cartItems                       CartItem[]
  orderItems                      OrderItem[]
  requestedInFulfillmentDecisions FulfillmentDecision[]
  vendorScores                    VendorScore[]
  vendorAssignments               VendorAssignment[]
  inventoryEvents                 InventoryEvent[]
  wasteDisposalRecords            WasteDisposalRecord[]
  reviews                         Review[]
  reservationCompensations        CartReservationCompensation[]
  reservationSyncStates           CartReservationSyncState[]
  cartItemAddAttempts             CartItemAddAttempt[]
  dailyListings                   VendorDailyListing[]
  cutoverFreshnessResetAudits     CutoverFreshnessResetAudit[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([lotId])
  @@index([catalogueItemId])
  @@map("products")
}

enum ProductReservationRestrictionState {
  PREPARED
  ENFORCED
  CLEARING
  CLEARED
}

enum ProductReservationRestrictionReason {
  ACCOUNTING_DRIFT
  MALFORMED_RESOURCE
  INCOMPLETE_EVIDENCE
}

model ProductReservationRestriction {
  id                      String                              @id @default(uuid()) @db.Uuid
  productId               String
  restrictionRevision     Int                                 @default(1)
  reasonCategory          ProductReservationRestrictionReason
  observationDigest       String
  state                   ProductReservationRestrictionState  @default(PREPARED)
  preparedAt              DateTime                            @default(now())
  firstEnforcedAt         DateTime?
  clearedAt               DateTime?                           @db.Timestamptz(3)
  clearedByRecoveryId     String?                             @db.Uuid
  physicalProtocolVersion Int                                 @default(1)
  product                 Product                             @relation(fields: [productId], references: [id], onDelete: Restrict)
  clearedByRecovery       ProductSuspectRecovery?             @relation("RestrictionClearedBy", fields: [clearedByRecoveryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  recoveries              ProductSuspectRecovery[]            @relation("RecoveryTargetRestriction")
  installations           ProductReservationRestrictionInstallation[]

  @@unique([productId, restrictionRevision])
  @@unique([id, productId, restrictionRevision])
  @@index([productId, state])
  @@map("reservation_product_restrictions")
}

model ProductReservationRestrictionInstallation {
  restrictionId        String @db.Uuid
  incarnation          String @db.Uuid
  epoch                Int
  protocolVersion      Int
  acknowledgement      String
  acknowledgementHash String
  confirmedAt          DateTime @default(now())
  restriction          ProductReservationRestriction @relation(fields: [restrictionId], references: [id], onDelete: Restrict)

  @@id([restrictionId, incarnation, epoch, protocolVersion])
  @@map("reservation_product_restriction_installations")
}

model Cart {
  ordinaryOwners OrdinaryReservationOwner[]
  id             String                     @id @default(uuid())
  customerId     String                     @unique
  currency       String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  customer              User                          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items                 CartItem[]
  checkoutAttempts      CheckoutAttempt[]
  checkoutOperations    CheckoutOperation[]
  compensations         CartReservationCompensation[]
  reservationSyncStates       CartReservationSyncState[]
  itemAddAttempts             CartItemAddAttempt[]
  cutoverFreshnessResetAudits CutoverFreshnessResetAudit[]

  @@unique([id, customerId])
  @@map("carts")
}

model CartItem {
  id              String    @id @default(uuid())
  cartId          String
  productId       String
  quantity        Int
  // Phase 16A.0-DA, Unit DA.1A. The compensation-guard/mutation-identity
  // token for this row - never quantity or updatedAt (see the DA.1
  // architecture review: quantity can cycle back to a previously-seen
  // value under concurrent writers, and updatedAt's millisecond precision
  // cannot be proven collision-free under genuine concurrent connections).
  // Bumped on every mutation that changes this row, including compensating
  // reverts - never reset, never reused across a delete/recreate cycle
  // (a fresh insert always restarts at 0, which is fine: the compensation
  // guard for a fresh insert only ever needs to detect "am I still the
  // only writer", not "am I still writer N").
  mutationVersion Int       @default(0)
  lockedUnitPrice Decimal?  @db.Decimal(10, 2)
  lockedCurrency  String?
  priceLockedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

enum CartReservationSyncStatus {
  PENDING
  PROCESSING
  BLOCKED
}

// Phase 16A.0-DA, Unit DA.4B (see the DA.4B frozen plan). Why a row is
// currently BLOCKED - distinct from any diagnostic reason that might live
// elsewhere, mirroring CompensationBlockReason's own separation from
// CompensationReasonCode in mirror-compensation (a different table, a
// structurally similar but independently-owned concept - see the
// recovery-authority split comment on CartReservationSyncRecoveryService).
enum CartReservationSyncBlockReason {
  PRODUCT_SUSPECT
  MODE_NOT_ADMITTING
}

// Phase 16A.0-DA, Unit DA.1A (see the DA.1 architecture review). Durable,
// proactive record of the desired Redis reservation state for one
// (cartId, productId) pair, written atomically with every CartItem
// mutation that affects reservation state (add/update/remove/compensating
// revert), before the corresponding Redis write is even attempted.
//
// This row is NEVER deleted once created, and never re-inserted for the
// same pair - resolution sets resolvedAt instead of removing the row. This
// is deliberate, not an oversight: CartItem.mutationVersion resets to 0 on
// every fresh insert (a delete followed by a later re-add restarts
// numbering), so it cannot serve as a logical generation for the pair's
// full lifetime - a stale compensation captured against a deleted row's
// version could otherwise numerically collide with a later, unrelated
// row's version. `generation` on THIS row is the fix: it lives on a row
// that is upserted (never deleted, never re-created) for as long as this
// (cartId, productId) pair exists, so it is a true, permanent,
// monotonically-increasing counter - immune to CartItem's own delete/
// recreate resets, and immune to the same problem repeating if the marker
// row itself were ever deleted and re-created (which is exactly why it
// isn't). Every mutation and every compensation attempt against this pair
// advances `generation`; resolution and compensation are both guarded on
// it, never on CartItem.mutationVersion. CartItem.mutationVersion remains
// in use only as the CartItem-table-level write guard (defense in depth,
// redundant with but not a substitute for the generation gate).
//
// DA.1A only ever writes PENDING and sets resolvedAt on success;
// PROCESSING/attemptCount/lastError/processingStartedAt are unused until
// DA.1B's recovery worker exists - included in this migration now so
// DA.1B never needs a second schema change for the same table.
model CartReservationSyncState {
  // Inert until explicit provenance-aware issuance is integrated. Never infer history.
  ordinaryProvenanceState      OrdinaryProvenanceState         @default(HISTORICAL_UNVERIFIED)
  ordinaryEnqueueSequence      Int                             @default(0)
  ordinaryCommandSequence      Int                             @default(0)
  ordinaryAcknowledgedSequence Int                             @default(0)
  ordinaryOwners               OrdinaryReservationOwner[]
  ordinaryCommands             OrdinaryReservationCommand[]
  id                           String                          @id @default(uuid())
  cartId                       String
  productId                    String
  // The CartItem.mutationVersion this row's expectedQuantity reflects as
  // of `generation`. Purely a historical/debugging value once the
  // CartItem has since been deleted - DA.1B relies on expectedQuantity
  // being null to mean "desired absence" in that case, never on this
  // field once no CartItem exists for the pair.
  expectedMutationVersion      Int
  // null = desired Redis state is "released/absent". Non-null = desired
  // absolute reservation quantity. Never a delta - matches
  // InventoryReservationsService.reserve/reserveOrRenew's own
  // absolute-quantity contract, which is what makes idempotent
  // reassertion safe in the first place.
  expectedQuantity             Int?
  status                       CartReservationSyncStatus       @default(PENDING)
  // Phase 16A.0-DA, Unit DA.4B. Why this row is currently BLOCKED - null
  // whenever status is not BLOCKED. See CartReservationSyncBlockReason.
  blockReason                  CartReservationSyncBlockReason?
  // Phase 16A.0-DA, Unit DA.4B. Meaningful only while status is BLOCKED -
  // when the next periodic recheck may run. This is a deliberate, narrow
  // exception to this table's "no nextAttemptAt/backoff column by design"
  // precedent (see findRecoveryCandidateIds's own comment): that precedent
  // covers ordinary PENDING/PROCESSING retries, which rely on batch-to-
  // batch cadence instead. BLOCKED did not exist when that precedent was
  // set - without a timing gate, a BLOCKED row would be re-examined
  // (calling reconcileProductReservedTotal, or re-reading mode) on every
  // single runBatch tick while genuinely waiting on an external condition,
  // never a "retry with growing backoff" concept the original precedent
  // was actually about.
  nextAttemptAt                DateTime?
  // The permanent logical generation for this (cartId, productId) pair -
  // see the model-level comment. Advances on every write to this row,
  // including compensation attempts, for as long as the row exists.
  generation                   Int                             @default(0)
  attemptCount                 Int                             @default(0)
  lastError                    String?
  processingStartedAt          DateTime?
  // Non-null once the current generation's desired Redis state has been
  // confirmed - never deleted, only set. A later mutation's upsert clears
  // it back to null (there is new, unconfirmed desired state again).
  resolvedAt                   DateTime?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  cart                        Cart                         @relation(fields: [cartId], references: [id], onDelete: Restrict)
  product                     Product                      @relation(fields: [productId], references: [id], onDelete: Restrict)
  cutoverFreshnessResetAudits CutoverFreshnessResetAudit[]
  suspectRecoveryTargets      ProductSuspectRecoveryTarget[]

  @@unique([cartId, productId])
  @@unique([id, cartId, productId])
  @@map("cart_reservation_sync_states")
