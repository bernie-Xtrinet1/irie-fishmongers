enum ReviewModerationStatus {
  VISIBLE
  REMOVED_BY_AUTHOR
  REMOVED_BY_ADMIN
}

// Customer reviews of a vendor (productId null) or a specific purchased
// product (productId set), always tied to the completed VendorOrder that
// makes the customer eligible (Phase 13A). FK deletes are deliberately
// non-cascading: reviews are trust/moderation records that must survive
// account or catalog changes - author SetNull (a deleted account's review
// text stays, attribution nulled), everything else Restrict so a vendor/
// order/product with reviews can't be physically deleted (this platform
// soft-deactivates instead). Removal is soft via moderationStatus, never a
// row delete.
//
// "Fake reviews are prohibited" (business-rules1.md) is enforced as a
// one-review-per-(author, vendorOrder, productId) DB constraint. Postgres
// treats every NULL as distinct, so a plain @@unique across a nullable
// productId would not block duplicate vendor-only reviews - the migration
// hand-adds two PARTIAL unique indexes instead (one WHERE productId IS
// NULL, one WHERE productId IS NOT NULL). That is why no @@unique appears
// on this model.
model Review {
  id               String                 @id @default(uuid())
  authorId         String?
  vendorId         String
  productId        String?
  vendorOrderId    String
  rating           Int
  title            String?
  body             String
  moderationStatus ReviewModerationStatus @default(VISIBLE)
  removedById      String?
  removalReason    String?
  removedAt        DateTime?
  editedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  author      User?            @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendorOrder VendorOrder      @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  removedBy   User?            @relation("ReviewRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  auditLogs   ReviewAuditLog[]

  @@index([vendorId, moderationStatus])
  @@index([productId, moderationStatus])
  @@map("reviews")
}

// Immutable trail of admin moderation actions on a review (Phase 13B).
// Structurally mirrors ComplianceAuditLog but with a stricter contract: the
// audit row is written in the SAME transaction as the moderation update, so
// a review can never be admin-removed without an accountable record of who
// did it and why (ReviewModerationService.remove). reviewId is Restrict
// (reviews are soft-deleted, never physically removed) and actorId is
// Restrict so the admin who acted can't be deleted out from under the trail.
model ReviewAuditLog {
  id          String   @id @default(uuid())
  reviewId    String
  actorId     String
  action      String
  beforeValue Json?
  afterValue  Json?
  reason      String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  actor  User   @relation("ReviewModerationActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reviewId])
  @@map("review_audit_logs")
}

