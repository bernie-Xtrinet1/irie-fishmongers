  idempotencyKey        String                        @unique
  payloadHash           String
  preparedNetWeight     Decimal?                      @db.Decimal(8, 3)
  partsOutcome          UsablePartsFulfillmentOutcome
  partsDisposalReason   String?
  preparedPhotoUrl      String?
  operatorUserId        String
  correctionReason      String?
  recordedAt            DateTime                      @default(now())

  weightAdjustment      SeafoodOrderWeightAdjustment  @relation(fields: [weightAdjustmentId], references: [id], onDelete: Restrict)
  operator              User                          @relation("PreparationFulfillmentOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)

  @@unique([weightAdjustmentId, revision], name: "uq_prep_adj_revision")
  @@index([weightAdjustmentId, recordedAt], name: "idx_prep_event_time")
  @@index([operatorUserId], name: "idx_prep_event_operator")
  @@map("seafood_preparation_fulfillment_events")
}

model CustomerCheckoutCeilingConsent {
  id                      String                       @id @default(uuid())
  weightAdjustmentId      String                       @unique
  authenticatedCustomerId String
  initialEstimatedWeight  Decimal                      @db.Decimal(8, 3)
  initialEstimatedTotal   Decimal                      @db.Decimal(10, 2)
  authorizedCeilingJmd    Decimal                      @db.Decimal(10, 2)
  termsVersion            String
  payloadHash             String
  // Additive V2 checkout quote identity & payload hash (Phase 16D WP4.3B.4C).
  // quoteId is indexed but NOT unique: a single checkout quote covers an order that may
  // contain multiple seafood line items, each with its own adjustment and consent row.
  quoteId                 String?
  quotePayloadHash        String?
  consentedAt             DateTime                     @default(now())
  ipAddress               String?
  userAgent               String?

  weightAdjustment        SeafoodOrderWeightAdjustment @relation(fields: [weightAdjustmentId], references: [id], onDelete: Restrict)
  customer                User                         @relation("CheckoutCeilingConsentCustomer", fields: [authenticatedCustomerId], references: [id], onDelete: Restrict)

  // Non-unique B-tree index supports collection queries for multi-item quotes (WP4.3B.4C.1A)
  @@index([quoteId], name: "idx_ceiling_consents_quote_id")
  @@map("customer_checkout_ceiling_consents")
}

model CustomerWeightApprovalRecord {
  id                      String                       @id @default(uuid())
  weightAdjustmentId      String
  measurementRevision     Int
  authenticatedCustomerId String
  proposedTotalJmd        Decimal                      @db.Decimal(10, 2)
  authorizedCeilingJmd    Decimal                      @db.Decimal(10, 2)
  action                  CustomerApprovalAction
  approvalTokenHash       String                       @unique
  payloadHash             String
  decidedAt               DateTime                     @default(now())
  ipAddress               String?
  userAgent               String?
  rejectionReason         String?

  weightAdjustment        SeafoodOrderWeightAdjustment @relation(fields: [weightAdjustmentId], references: [id], onDelete: Restrict)
  customer                User                         @relation("WeightApprovalCustomer", fields: [authenticatedCustomerId], references: [id], onDelete: Restrict)

  @@unique([weightAdjustmentId, measurementRevision], name: "uq_approval_adj_revision")
  @@index([weightAdjustmentId, decidedAt], name: "idx_approval_time")
  @@map("customer_weight_approval_records")
}

model CustomerWeightApprovalChallenge {
  id                      String                        @id @default(uuid())
  weightAdjustmentId      String
  measurementRevision     Int
  challengeSequence       Int                           @default(1)
  authenticatedCustomerId String
  proposedTotalJmd        Decimal                       @db.Decimal(10, 2)
  authorizedCeilingJmd    Decimal                       @db.Decimal(10, 2)
  differenceAmountJmd     Decimal                       @db.Decimal(10, 2)
  approvalTokenHash       String                        @unique
  expiresAt               DateTime
  status                  ApprovalChallengeStatus       @default(OPEN)
  consumedAt              DateTime?
  revokedAt               DateTime?
  revocationReason        String?
  createdAt               DateTime                      @default(now())

  weightAdjustment        SeafoodOrderWeightAdjustment  @relation(fields: [weightAdjustmentId], references: [id], onDelete: Restrict)
  customer                User                          @relation("ApprovalChallengeCustomer", fields: [authenticatedCustomerId], references: [id], onDelete: Restrict)

  @@unique([weightAdjustmentId, measurementRevision, challengeSequence], name: "uq_challenge_adj_rev_seq")
  @@index([weightAdjustmentId, measurementRevision, status], name: "idx_challenge_adj_rev_status")
  @@index([status, expiresAt], name: "idx_challenge_status_expiry")
  @@map("customer_weight_approval_challenges")
}

model WeightAdjustmentObligation {
  id                     String                       @id @default(uuid())
  weightAdjustmentId     String
  revision               Int
  idempotencyKey         String                       @unique
  payloadHash            String
  direction              PaymentObligationDirection
  amountJmd              Decimal                      @db.Decimal(10, 2)
  status                 ObligationStatus             @default(PENDING)
  createdAt              DateTime                     @default(now())

  weightAdjustment       SeafoodOrderWeightAdjustment @relation(fields: [weightAdjustmentId], references: [id], onDelete: Restrict)
  settlementRecords      WeightAdjustmentSettlementRecord[]

  @@unique([weightAdjustmentId, revision], name: "uq_obligation_adj_revision")
  @@index([direction, status], name: "idx_obligation_dir_status")
  @@map("weight_adjustment_obligations")
}

model WeightAdjustmentSettlementRecord {
  id                  String                     @id @default(uuid())
  obligationId        String
  idempotencyKey      String                     @unique
  payloadHash         String
  settlementChannel   SettlementChannel
  amountSettled       Decimal                    @db.Decimal(10, 2)
  externalReference   String?
  evidenceDocumentUrl String?
  settledByUserId     String
  settledAt           DateTime                   @default(now())

  obligation          WeightAdjustmentObligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  settledByUser       User                       @relation("AdjustmentSettlementRecorder", fields: [settledByUserId], references: [id], onDelete: Restrict)

  @@index([obligationId, settledAt], name: "idx_settlement_time")
  @@index([settlementChannel], name: "idx_settlement_channel")
  @@map("weight_adjustment_settlement_records")
}

// ============================================================================
// WP4.3B.4F.7D.4B.6K-M67: DEDICATED FRESHNESS-RESET AUDIT & CRASH-RECOVERY
// ============================================================================

enum CutoverFreshnessResetStatus {
  PREPARED
  COMPLETED
  ABORTED
}

// Durable administrative authorization, execution, and crash-recovery audit
// ledger for W1 FRESHNESS_SWEEP operations. A PREPARED record captures
// pre-execution authorization only and never by itself authorizes an
// unrestricted Redis mutation. Terminal COMPLETED/ABORTED rows and identity
// columns are database-enforced immutable and delete/truncate protected.
model CutoverFreshnessResetAudit {
  id                       String                      @id @default(uuid()) @db.Uuid
  requestId                String                      @unique @db.Uuid
  cutoverRunId             String                      @db.Uuid
  barrierRevision          Int
  fenceTransitionId        String                      @db.Uuid
  incarnation              String                      @db.Uuid
  fenceEpoch               Int
  fenceRevision            Int
  modeRevision             Int
  markerId                 String
  generation               Int
  holdInstanceId           String                      @db.Uuid
  customerId               String
  cartId                   String
  productId                String
  quantity                 Int
  operatorId               String
  authorizationEffect      String                      @default("FRESHNESS_SWEEP") @db.VarChar(32)
  authorizationPhase       String                      @default("OPEN") @db.VarChar(16)
  permitTtlMs              Int                         @default(5000)
  reason                   String                      @default("CUTOVER_FRESHNESS_SWEEP") @db.VarChar(128)
  status                   CutoverFreshnessResetStatus @default(PREPARED)
  anchorNowMs              BigInt
  priorCreatedAtMs         BigInt?
  priorLastRenewedAtMs     BigInt?
  priorExpiresAtMs         BigInt?
  priorAbsoluteExpiresAtMs BigInt?
  newCreatedAtMs           BigInt?
  newLastRenewedAtMs       BigInt?
  newExpiresAtMs           BigInt?
  newAbsoluteExpiresAtMs   BigInt?
  redisReceipt             String?
  redisReceiptHash         String?                     @db.Char(64)
  failureCode              String?                     @db.VarChar(64)
  failureDetail            String?                     @db.VarChar(500)
  createdAt                DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                    @updatedAt @db.Timestamptz(3)
  completedAt              DateTime?                   @db.Timestamptz(3)

  barrierConfig   CartMutationBarrierConfig  @relation(fields: [barrierRevision], references: [revision], onDelete: Restrict, onUpdate: Restrict, map: "cutover_freshness_resets_barrier_fkey")
  fenceTransition ReservationFenceTransition @relation(fields: [fenceTransitionId, incarnation, fenceEpoch], references: [id, incarnation, epoch], onDelete: Restrict, onUpdate: Restrict, map: "cutover_freshness_resets_fence_fkey")
  marker          CartReservationSyncState   @relation(fields: [markerId, cartId, productId], references: [id, cartId, productId], onDelete: Restrict, onUpdate: Restrict, map: "cutover_freshness_resets_marker_fkey")
  cart            Cart                       @relation(fields: [cartId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict, map: "cutover_freshness_resets_cart_fkey")
  product         Product                    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cutover_freshness_resets_product_fkey")
  operator        User                       @relation("FreshnessResetOperator", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "cutover_freshness_resets_operator_fkey")

  @@unique([cutoverRunId, barrierRevision, markerId, generation], map: "cutover_freshness_resets_idempotency_key")
  @@index([status, createdAt], map: "cutover_freshness_resets_status_createdAt_idx")
  @@index([cutoverRunId, status], map: "cutover_freshness_resets_run_status_idx")
  @@index([cartId, productId, createdAt], map: "cutover_freshness_resets_cart_product_idx")
  @@index([markerId, generation], map: "cutover_freshness_resets_marker_gen_idx")
  @@map("cutover_freshness_resets")
}

enum ProductSuspectRecoveryStatus {
  REQUESTED
  APPROVED
  EXECUTING
  AMBIGUOUS_QUARANTINED
  COMPLETED
  ABORTED
  EXPIRED
  REJECTED
}

enum ProductSuspectExecutionEvidence {
  APPLIED
  NOT_APPLIED
  UNKNOWN
  AMBIGUOUS
}

enum ProductSuspectRecoveryTargetKind {
  COMPENSATION
  SYNC_STATE
}

model ProductSuspectRecovery {
  id                        String                         @id @default(uuid()) @db.Uuid
  requestId                 String                         @unique @db.Uuid
  productId                 String
  restrictionId             String?                        @db.Uuid
  targetRestrictionRevision Int                            @default(0)
  clearedControlRevision    Int
  status                    ProductSuspectRecoveryStatus   @default(REQUESTED)
  modeRevision              Int
  fenceTransitionId         String                         @db.Uuid
  incarnation               String                         @db.Uuid
  fenceEpoch                Int
  fenceRevision             Int
  authorizationPhase        ReservationFencePhase
  requestedById             String
  requestedAt               DateTime                       @default(now()) @db.Timestamptz(3)
  requestReason             String                         @db.VarChar(256)
  observationDigest         String                         @db.Char(64)
  approvedById              String?
  approvedAt                DateTime?                      @db.Timestamptz(3)
  approvalExpiresAt         DateTime?                      @db.Timestamptz(3)
  approvalDigest            String?                        @db.Char(64)
  rejectedById              String?
  rejectedAt                DateTime?                      @db.Timestamptz(3)
  rejectionReason           String?                        @db.VarChar(256)
  reconciliationSnapshot    Json
  reconciliationDigest      String                         @db.Char(64)
  priorStoredTotal          Int?
  targetReconciledTotal     Int
  priorSuspectPresent       Boolean
  affectedMarkerCount       Int                            @default(0)
  affectedCompensationCount Int                            @default(0)
  permitTtlMs               Int                            @default(5000)
  stagedControlRevision     Int?
  executingAt               DateTime?                      @db.Timestamptz(3)
  executionEvidence         ProductSuspectExecutionEvidence?
  evidenceEvaluatedAt       DateTime?                      @db.Timestamptz(3)
  evidenceDetail            Json?
  quarantinedAt             DateTime?                      @db.Timestamptz(3)
  quarantineReason          String?                        @db.VarChar(128)
  redisReceipt              String?
  redisReceiptHash          String?                        @db.Char(64)
  failureCode               String?                        @db.VarChar(64)
  failureDetail             String?                        @db.VarChar(500)
  completedAt               DateTime?                      @db.Timestamptz(3)
  createdAt                 DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                       @default(now()) @updatedAt @db.Timestamptz(3)

  product             Product                        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recoveries_product_fkey")
  targetRestriction   ProductReservationRestriction? @relation("RecoveryTargetRestriction", fields: [restrictionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recoveries_restriction_fkey")
  clearedRestrictions ProductReservationRestriction[] @relation("RestrictionClearedBy")
  fenceTransition     ReservationFenceTransition     @relation(fields: [fenceTransitionId, incarnation, fenceEpoch], references: [id, incarnation, epoch], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recoveries_fence_fkey")
  requestedBy         User                           @relation("SuspectRecoveryRequester", fields: [requestedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recoveries_requester_fkey")
  approvedBy          User?                          @relation("SuspectRecoveryApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recoveries_approver_fkey")
  rejectedBy          User?                          @relation("SuspectRecoveryRejector", fields: [rejectedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recoveries_rejector_fkey")
  targets             ProductSuspectRecoveryTarget[]

  @@unique([id, productId])
  @@index([productId, status], map: "product_suspect_recoveries_product_status_idx")
  @@index([status, createdAt], map: "product_suspect_recoveries_status_createdAt_idx")
  @@map("product_suspect_recoveries")
}

model ProductSuspectRecoveryTarget {
  id                 String                           @id @default(uuid()) @db.Uuid
  recoveryId         String                           @db.Uuid
  productId          String
  targetKind         ProductSuspectRecoveryTargetKind
  compensationId     String?
  syncStateId        String?
  expectedGeneration Int
  priorStatus        String
  priorBlockReason   String
  unblockedAt        DateTime?                        @db.Timestamptz(3)
  createdAt          DateTime                         @default(now()) @db.Timestamptz(3)

  recovery     ProductSuspectRecovery      @relation(fields: [recoveryId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recovery_targets_recovery_fkey")
  compensation CartReservationCompensation? @relation(fields: [compensationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recovery_targets_compensation_fkey")
  syncState    CartReservationSyncState?   @relation(fields: [syncStateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "product_suspect_recovery_targets_sync_state_fkey")

  @@unique([recoveryId, compensationId], map: "product_suspect_recovery_targets_recoveryId_compensationId_key")
  @@unique([recoveryId, syncStateId], map: "product_suspect_recovery_targets_recoveryId_syncStateId_key")
  @@index([productId, recoveryId], map: "product_suspect_recovery_targets_product_recovery_idx")
  @@map("product_suspect_recovery_targets")
}
