# Backend API base URL, including the /api/v1 prefix. Compiled into the client
# bundle at BUILD time (NEXT_PUBLIC_*). The app reads it softly - it falls back
# to the relative '/api/v1' (served via API_PROXY_TARGET) when unset.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional SERVER-runtime rewrite target. When set, Next forwards /api/v1/* to
# this backend origin server-side so the browser stays same-origin (no CORS, no
# SameSite cookie hop) - used by the Codespaces demo. Leave unset for local
# direct calls or when NEXT_PUBLIC_API_URL is an absolute URL.
# API_PROXY_TARGET=http://localhost:3001

# SERVER-runtime port the Next.js server listens on.
PORT=3000
